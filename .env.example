# --- PostgreSQL (docker compose; см. docker-compose.yml, README) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=dev
POSTGRES_DB=app
# Порт на хосте (по умолчанию 5432)
# POSTGRES_PORT=5432

# --- Backend (см. backend/config.py, docs/adr/adr-002-backend-http-orm.md) ---
# Обязательно: async SQLAlchemy + asyncpg. Для локального compose совпадает с POSTGRES_* выше:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://app:dev@127.0.0.1:5432/app
# Для asyncpg по умолчанию ssl=False (см. backend/config.py ASYNCPG_CONNECT_ARGS) — устраняет сбои подключения к локальному Postgres без TLS.

# Отдельная БД для pytest backend/tests: если задано, имеет приоритет над DATABASE_URL (см. backend/tests/conftest.py, docs/tests.md)
# TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/test_db

# Bind uvicorn (backend/main.py)
API_HOST=127.0.0.1
API_PORT=8000
# CORS для веб-клиента (Next.js): Origin через запятую. Если пусто — в коде разрешены 127.0.0.1:3000 и localhost:3000
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Общий секрет для bot → backend (Authorization: Bearer …). Контракт: docs/api/backend-v1.openapi.yaml
INTERNAL_API_TOKEN=

# JWT веб-сессии (POST /v1/auth/web-session). HS256 на backend (см. backend/config.py)
# Если пусто: при заданном INTERNAL_API_TOKEN возможен производный секрет для локальной разработки.
JWT_SECRET=
# Срок JWT в секундах (по умолчанию в коде: 604800 = 7 суток)
JWT_EXPIRES_IN_SECONDS=

LOG_LEVEL=INFO

# LLM через OpenRouter (ответы ассистента в диалоге)
OPENROUTER_API_KEY=
# По умолчанию в коде: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.7
# Лимит сообщений в контексте диалога на сервере (по умолчанию в коде: 30)
MAX_HISTORY_MESSAGES=

# Whisper STT (POST /v1/voice/dialog-messages). Без ключа голос недоступен на backend (503).
OPENAI_API_KEY=
# Опционально: лимит размера тела голосового в байтах (по умолчанию 25 MiB в коде).
# VOICE_MAX_BYTES=

# Системный промпт потока хранится в БД (Flow.system_prompt); бот его не задаёт.
# LLM_MAX_TOKENS=

# --- Bot (HTTP-клиент к backend; без прямого OpenRouter) ---
# Базовый URL backend без завершающего слэша (совпадает с http://API_HOST:API_PORT)
BACKEND_BASE_URL=http://127.0.0.1:8000
BOT_TOKEN=
# UUID потока из таблицы flows — тот же flow_id, что в POST /v1/dialog-messages
FLOW_ID=

# --- Web (клиент в web/; переменные читает Next.js из web/.env.local) ---
# Скопируйте пример: web/.env.example → web/.env.local
# NEXT_PUBLIC_BACKEND_BASE_URL=http://127.0.0.1:8000
# Demo-значения для формы входа (опционально; если не задано, используются встроенные fallback)
# NEXT_PUBLIC_DEMO_USER=bondarenko_alexey_nikolaevich
# NEXT_PUBLIC_DEMO_FLOW=00000000-0000-0000-0000-000000000001
